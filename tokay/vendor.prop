# Audio
ro.audio.spatializer_enabled=true

# Bluetooth
persist.bluetooth.a2dp_offload.cap=sbc-aac-aptx-aptxhd-ldac-opus
ro.vendor.bluetooth.evb_bdaddr=22:22:22:33:44:55

# DCK
ro.gms.dck.eligible_wcc=2

# Display
ro.surface_flinger.set_idle_timer_ms=1000
ro.vendor.display.read_temp_interval=30
ro.vendor.primarydisplay.google-tk4c.temperature_path=/dev/thermal/tz-by-name/disp_therm/temp

# Fingerprint
log.tag.QFP=3
persist.vendor.qfp.enable_setprop=0

# GPS
ro.vendor.gps.atom.enabled=true

# LMKD
ro.lmk.swap_free_low_percentage=7

# Media
ro.odm.build.media_performance_class=35

# PKVM
hypervisor.memory_reclaim.supported=1

# Radio
persist.vendor.ril.use_radio_hal=2.2
ro.vendor.ril.use_radio_hal=2.2

# SVN
ro.vendor.build.svn=58

# Vibrator
persist.vendor.vibrator.hal.context.scale=60
ro.vendor.vibrator.hal.chirp.enabled=1
ro.vendor.vibrator.hal.device.mass=0.222
ro.vendor.vibrator.hal.loc.coeff=2.8
vendor.audio.hapticgenerator.distortion.output.gain=0.48

# Wi-Fi
ro.vendor.wifi.model=bcm4390
