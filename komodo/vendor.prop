# Audio
ro.audio.spatializer_enabled=true

# Bluetooth
persist.bluetooth.a2dp_offload.cap=sbc-aac-aptx-aptxhd-ldac-opus
ro.vendor.bluetooth.evb_bdaddr=22:22:22:33:44:55

# DCK
ro.gms.dck.eligible_wcc=3

# Display
persist.vendor.display.primary.boot_config=1008x2244@120:120
ro.vendor.primarydisplay.blocking_zone.min_refresh_rate_by_nits=5:120,:1
ro.vendor.primarydisplay.preferred_mode=1008x2244@120:120
ro.vendor.primarydisplay.vrr.expected_present.headsup_ns=30000000
ro.vendor.primarydisplay.vrr.expected_present.timeout_ns=500000000
ro.vendor.primarydisplay.xrr.version=2.1
vendor.display.0.brightness.acl.default=1
vendor.primarydisplay.fixed_te2.default_rate_hz=120
vendor.primarydisplay.op.hs_hz=120
vendor.primarydisplay.op.ns_hz=120

# Fingerprint
log.tag.QFP=3
persist.vendor.qfp.enable_setprop=0

# GPS
ro.vendor.gps.atom.enabled=true

# Media
ro.odm.build.media_performance_class=35

# PKVM
hypervisor.memory_reclaim.supported=1

# Radio
persist.vendor.ril.use_radio_hal=2.2
ro.vendor.ril.use_radio_hal=2.2

# SVN
ro.vendor.build.svn=58

# Vibrator
persist.vendor.vibrator.hal.context.scale=60
ro.vendor.vibrator.hal.chirp.enabled=1
ro.vendor.vibrator.hal.device.mass=0.222
ro.vendor.vibrator.hal.loc.coeff=2.8
vendor.audio.hapticgenerator.distortion.output.gain=0.48

# Wi-Fi
ro.vendor.wifi.model=bcm4390
